# Racine — Docker Compose (copier vers .env à la racine du dépôt)

# MySQL (service mysql)
MYSQL_ROOT_PASSWORD=synapse
MYSQL_PORT=3306

# phpMyAdmin (interface web MySQL) — http://localhost:<port>
PHPMYADMIN_PORT=8550

# Base utilisée par le Control Plane (Nest + même valeur MYSQL_DATABASE au premier démarrage)
DB_NAME=synapse_control

# Ports exposés sur la machine hôte
CONTROL_API_PORT=8547
CONTROL_UI_PORT=8548
# Agent : port HÔTE → conteneur 8000 (aligné sur agent/.env, ex. 8546)
API_PORT=8546

# Agent : copier aussi agent/.env depuis agent/.env.example (clés LLM, etc.)
