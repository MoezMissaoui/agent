# Copy to .env and fill in values.
API_HOST=localhost
API_PORT=8546

# Si défini, toutes les routes /internal/v1 exigent l'en-tête X-API-Key (Swagger : Authorize).
# INTERNAL_API_KEY=

# LLM for /internal/v1/chat: gemini | openai
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
# Used only when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

CHROMA_PERSIST_PATH=./chroma_data
GLOBAL_COLLECTION_NAME=global_rag_collection
# Top-K chunks from similarity search (default 15). Large values still get cut by RAG_MAX_CONTEXT_CHARS.
RAG_N_RESULTS=15
# Max total characters from chunks sent to the LLM (default 280000). Prevents 400 context length errors.
RAG_MAX_CONTEXT_CHARS=280000

# Logs : un fichier par jour LOG_DIR/YYYY-MM-DD.log ; suppression des jours plus vieux que LOG_RETENTION_DAYS
LOG_DIR=./logs
LOG_RETENTION_DAYS=5
# DEBUG | INFO | WARNING | ERROR | CRITICAL | NOTSET (NOTSET≈tout via DEBUG côté fichier)
LOG_LEVEL=DEBUG

# Optional: e.g. sentence-transformers/all-MiniLM-L6-v2 (requires pip install sentence-transformers)
# EMBEDDING_MODEL=

# Port HTTP local (run.py) ; pour Docker, le compose racine mappe ce port hôte → 8000 dans le conteneur (voir README).
