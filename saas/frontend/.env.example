# API Control Plane (Nest) — aligner avec FRONTEND_URL côté backend / CORS
VITE_API_URL=http://localhost:8547
# Même secret qu’une entrée `token` dans API_KEYS_JSON / config/api-keys côté backend
VITE_API_KEY=synapse-dev-api-key-change-me

# Nom affiché dans l’en-tête des pages auth (logo texte)
VITE_APP_NAME=Synapse
