PORT=8547
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=synapse_control

# Auth (JWT)
JWT_SECRET=change-me-in-production-use-long-random-string
# Access token TTL (session)
JWT_ACCESS_EXPIRES_IN=1d
JWT_ACCESS_REMEMBER_EXPIRES_IN=7d
# Refresh token TTL
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# CORS + liens reset password
FRONTEND_URL=http://localhost:8548
PASSWORD_RESET_TTL_MINUTES=60

# Email: dev = log link only; smtp = Nodemailer (set all MAIL_* below)
MAIL_MAILER=dev
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=ssl
# Optional: override From (defaults to MAIL_USERNAME)
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_PASSWORD_RESET_SUBJECT=Reset your password
