PORT=8547
NODE_ENV=development

# Swagger UI : http://localhost:PORT/docs (HTTP Basic — navigateur demande user / mot de passe)
SWAGGER_USER=moez
SWAGGER_PASSWORD=moez

# X-API-Key (obligatoire — sinon le serveur refuse de démarrer). Priorité : API_KEYS_JSON > fichier.
API_KEYS_JSON=[{"name":"control-plane-web","token":"synapse-dev-api-key-change-me"}]
# Alternative : API_KEYS_FILE=config/api-keys.local.json (copier depuis config/api-keys.example.json)

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=synapse_control

# Auth (JWT)
JWT_SECRET=change-me-in-production-use-long-random-string
# Access token TTL (session)
JWT_ACCESS_EXPIRES_IN=1d
JWT_ACCESS_REMEMBER_EXPIRES_IN=7d
# Refresh token TTL
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# CORS + liens reset password + redirect OAuth Google
FRONTEND_URL=http://localhost:8548

# Google OAuth (optionnel — si les trois sont définis, routes GET /auth/google + callback sont actives)
# Console Google : type « Application Web » — URI de redirection = valeur exacte de GOOGLE_CALLBACK_URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8547/api/v1.0/auth/google/callback
PASSWORD_RESET_TTL_MINUTES=60

# Email : remplir MAIL_HOST + MAIL_USERNAME + MAIL_PASSWORD pour envoyer (y compris NODE_ENV=development)
# Optionnel : MAIL_MAILER=log pour forcer uniquement le log console (ignore SMTP)
# MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
# Optional: override From (defaults to MAIL_USERNAME)
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_PASSWORD_RESET_SUBJECT=Reset your password
